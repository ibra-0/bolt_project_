[{"id":"campus-flow","type":"tab","label":"Practice 12 - Campus availability","disabled":false,"info":"Real Node-RED low-code flow, fixed fictional room, no external connectors."},{"id":"campus-ui","type":"ui-base","name":"Smart Campus - Low-code","path":"/dashboard","includeClientData":true,"acceptsClientConfig":[],"showPathInSidebar":false,"navigationStyle":"default","titleBarStyle":"default","showReconnectNotification":true,"showDisconnectNotification":true},{"id":"campus-theme","type":"ui-theme","name":"Campus blue","colors":{"surface":"#ffffff","primary":"#1565c0","bgPage":"#f3f6fa","groupBg":"#ffffff","groupOutline":"#d5dee9"},"sizes":{"density":"default","pagePadding":"24px","groupGap":"16px","groupBorderRadius":"12px","widgetGap":"16px"}},{"id":"campus-page","type":"ui-page","name":"Room 101 availability","ui":"campus-ui","path":"/room","icon":"home","layout":"grid","theme":"campus-theme","order":1,"visible":"true","disabled":"false","breakpoints":[{"name":"Default","px":0,"cols":3},{"name":"Tablet","px":576,"cols":6},{"name":"Desktop","px":1024,"cols":12}]},{"id":"campus-group","type":"ui-group","name":"LOW-CODE · Node-RED / FlowFuse Dashboard","page":"campus-page","width":6,"height":1,"order":1,"showTitle":true,"visible":true,"disabled":false,"groupType":"default"},{"id":"campus-form","type":"ui-form","z":"campus-flow","name":"Start / duration / room status","x":140,"y":100,"wires":[["fixed-context"]],"group":"campus-group","label":"Fixed mock time 09:00 · Booking 10:00-11:00","order":1,"width":6,"height":0,"options":[{"key":"startTime","label":"Start time","type":"text","required":true},{"key":"duration","label":"Duration (minutes)","type":"number","required":true},{"key":"blocked","label":"Room blocked","type":"checkbox","required":false}],"formValue":{"startTime":"12:00","duration":30,"blocked":false},"submit":"Check availability","cancel":"","resetOnSubmit":false,"passthru":false,"topic":"campus","topicType":"str","splitLayout":false},{"id":"test-api","type":"http in","z":"campus-flow","name":"Local test entry: same workflow","x":150,"y":180,"wires":[["fixed-context"]],"url":"/campus/check","method":"post","upload":false,"swaggerDoc":""},{"id":"fixed-context","type":"change","z":"campus-flow","name":"Fixed clock and bookings","x":410,"y":100,"wires":[["validate"]],"rules":[{"t":"set","p":"mock","pt":"msg","to":"{\"now\":540,\"existing\":[[600,660]]}","tot":"json"}]},{"id":"validate","type":"function","z":"campus-flow","name":"Normalize and validate inputs","x":670,"y":100,"wires":[["blocked-switch"],["present"]],"func":"const p=msg.payload||{};\nconst fail=(code,text)=>{msg.payload={available:false,reasonCode:code,message:text,existingBookings:msg.mock.existing};return [null,msg];};\nif(typeof p.startTime!==\"string\"||p.startTime.length>16||typeof p.blocked!==\"boolean\") return fail(\"INVALID_INPUT\",\"Enter a valid start time and room status.\");\nconst text=p.startTime.trim(); let start=null;\nif(/^\\d+$/.test(text)){const n=Number(text);if(Number.isSafeInteger(n)&&n<=1440)start=n;}\nelse{const m=text.match(/^(\\d{1,2}):(\\d{2})$/);if(m){const h=Number(m[1]),v=Number(m[2]);if(h<=24&&v<60&&(h!==24||v===0))start=h*60+v;}}\nif(start===null)return fail(\"INVALID_INPUT\",\"Start time must use HH:MM or whole minutes.\");\nconst raw=String(p.duration).trim();const duration=/^\\d+$/.test(raw)?Number(raw):NaN;\nif(!Number.isSafeInteger(duration)||duration<=0||duration>120)return fail(\"INVALID_DURATION\",\"Duration must be a whole number from 1 to 120 minutes.\");\nif(start+duration>1440)return fail(\"INVALID_TIME\",\"The requested interval must fit within the day.\");\nmsg.payload={start,end:start+duration,duration,blocked:p.blocked};return [msg,null];","outputs":2,"timeout":0,"noerr":0,"initialize":"","finalize":"","libs":[]},{"id":"blocked-switch","type":"switch","z":"campus-flow","name":"Room blocked?","x":930,"y":100,"wires":[["blocked-result"],["future-switch"]],"property":"payload.blocked","propertyType":"msg","rules":[{"t":"true"},{"t":"else"}],"checkall":"false","repair":false,"outputs":2},{"id":"blocked-result","type":"change","z":"campus-flow","name":"BLOCKED","x":1180,"y":60,"wires":[["present"]],"rules":[{"t":"set","p":"payload","pt":"msg","to":"{\"available\":false,\"reasonCode\":\"BLOCKED\",\"message\":\"Room 101 is marked as blocked.\",\"existingBookings\":mock.existing}","tot":"jsonata"}]},{"id":"future-switch","type":"switch","z":"campus-flow","name":"Start after 09:00?","x":1180,"y":140,"wires":[["past-result"],["overlap"]],"property":"payload.start","propertyType":"msg","rules":[{"t":"lte","v":"540","vt":"num"},{"t":"else"}],"checkall":"false","repair":false,"outputs":2},{"id":"past-result","type":"change","z":"campus-flow","name":"PAST_TIME","x":1410,"y":100,"wires":[["present"]],"rules":[{"t":"set","p":"payload","pt":"msg","to":"{\"available\":false,\"reasonCode\":\"PAST_TIME\",\"message\":\"Start time must be after the current mock time 09:00.\",\"existingBookings\":mock.existing}","tot":"jsonata"}]},{"id":"overlap","type":"function","z":"campus-flow","name":"Overlap (touching is allowed)","x":1430,"y":200,"wires":[["present"]],"func":"const conflict=msg.mock.existing.some(b=>msg.payload.start<b[1]&&b[0]<msg.payload.end);\nmsg.payload={available:!conflict,reasonCode:conflict?\"OVERLAP\":\"AVAILABLE\",message:conflict?\"This interval overlaps the existing 10:00-11:00 booking.\":\"Room 101 is available for this interval.\",existingBookings:msg.mock.existing};\nreturn msg;","outputs":1,"timeout":0,"noerr":0,"initialize":"","finalize":"","libs":[]},{"id":"present","type":"function","z":"campus-flow","name":"Result and HTTP status","x":1690,"y":100,"wires":[["campus-result","has-http"]],"func":"msg.payload.status=msg.payload.available?\"AVAILABLE\":\"UNAVAILABLE\";msg.statusCode=msg.payload.reasonCode.startsWith(\"INVALID_\")?400:200;return msg;","outputs":1,"timeout":0,"noerr":0,"initialize":"","finalize":"","libs":[]},{"id":"campus-result","type":"ui-text","z":"campus-flow","name":"Visible decision and reason","x":1960,"y":60,"wires":[],"group":"campus-group","order":2,"width":6,"height":0,"label":"Decision (check only; bookings unchanged)","format":"{{msg.payload}}","layout":"col-center","style":false,"font":"Arial","fontSize":18,"color":"#10253f","wrapText":true,"className":"","value":"payload.status & ' | ' & payload.reasonCode & ' | ' & payload.message","valueType":"jsonata"},{"id":"has-http","type":"switch","z":"campus-flow","name":"HTTP request only","x":1930,"y":160,"wires":[["http-result"]],"property":"res","propertyType":"msg","rules":[{"t":"nnull"}],"checkall":"true","repair":false,"outputs":1},{"id":"http-result","type":"http response","z":"campus-flow","name":"JSON test result","x":2160,"y":160,"wires":[],"statusCode":"","headers":{"Content-Type":"application/json"}}]